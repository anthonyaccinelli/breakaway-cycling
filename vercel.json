{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/cycle-quest.js": {
      "includeFiles": "cycle-quest/**"
    }
  },
  "redirects": [
    {
      "source": "/spindlkin",
      "destination": "/spindlkin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/spindlkin/:path*",
      "destination": "https://pedalkin-preview.vercel.app/:path*"
    }
  ]
}
